{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "public/build" }
    },
    {
      "src": "public/index.php",
      "use": "vercel-php@0.8.0"
    },
    {
      "src": "public/**/*.{ico,txt,png,jpg,jpeg,gif,svg,webp}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/$1" },
    { "src": "/storage/(.*)", "dest": "/public/storage/$1" },
    { "src": "/img/(.*)", "dest": "/public/img/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}
