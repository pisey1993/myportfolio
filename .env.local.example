# Admin panel (app/admin) — password for the single admin login.
# Copy this file to .env.local, set a real value, then run `npm run dev`.
ADMIN_PASSWORD=

# Optional: separate secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD if unset.
SESSION_SECRET=

# Used to build absolute URLs for blog post share buttons.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Only needed to make the admin panel work on Vercel (or anywhere else with a
# read-only filesystem) — see README "Deploying the admin panel" for setup steps. ---

# A GitHub personal access token with write access to this repo's contents.
# When set, admin saves commit to GitHub (which triggers a redeploy) instead of
# writing to disk. Leave unset for local dev — local saves just write the file directly.
GITHUB_TOKEN=

# "owner/repo" — defaults to pisey1993/myportfolio if unset.
GITHUB_REPO=

# Branch to commit to — defaults to "main" if unset.
GITHUB_BRANCH=
