# Postgres (from Vercel Postgres / Neon integration)
DATABASE_URL=

# Vercel Blob (for avatar upload in admin settings)
BLOB_READ_WRITE_TOKEN=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# One-time admin seed (used only by scripts/seed.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gemini (AI post generation) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: contact form email notifications (falls back to DB-only save if unset)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=you@example.com
